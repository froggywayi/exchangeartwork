          const a = document.createElement('a');
          a.href = url;
          a.download = `課堂互評成果總結報告_${new Date().toISOString().slice(0, 10)}.txt`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast("已成功下載報告檔案！", "success");
        });
      }

      // -------------------------------------------------------------
      // 7. INITIALIZATION
      // -------------------------------------------------------------
      function init() {
        const hasSaved = loadStateFromStorage(true);
        setupEventListeners();
        
        if (hasSaved) {
          const banner = document.getElementById("sessionResumedBanner");
          const bannerText = document.getElementById("sessionResumedText");
          const student = appState.students.find(s => s.id === appState.currentStudentId) || appState.students[0];
          let pText = "階段一：限時上傳";
          if (appState.phase === 2) pText = "階段二：同儕隨機互評";
          if (appState.phase === 3) pText = "階段三：原作者收回意見";
          if (bannerText) {
            bannerText.textContent = `歡迎回來，${student.number} ${student.name}！已為你自動恢復上次未完成的【${pText}】進度。`;
          }
          if (banner) banner.classList.remove("hidden");
          
          if (appState.activeRole === "student") {
            if (appState.phase === 1) switchStudentTab("upload");
            else if (appState.phase === 2) switchStudentTab("review");
            else if (appState.phase === 3) switchStudentTab("feedback");
          }
          transitionToPhase(appState.phase);
        } else {
          renderAll();
          startTimer();
        }
      }

      // Run on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</body>
</html>
