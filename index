            likeTag.classList.remove('hidden');
          } else {
            likeBtn.classList.remove('bg-pink-100', 'text-pink-700', 'border-pink-300');
            likeTag.classList.add('hidden');
          }

        } else {
          noFeedbackYetBox.classList.remove('hidden');
          receivedFeedbackContainer.classList.add('hidden');
          feedbackDot.classList.add('hidden');
        }
      }

