          }

          let selectedBadge = "🎨 色彩魔術師";
          const radios = document.getElementsByName('reviewBadge');
          for (let r of radios) {
            if (r.checked) selectedBadge = r.value;
          }

          reviewer.reviewGiven = {
            submitted: true,
            pros: pros,
            cons: cons,
            badge: selectedBadge
          };

          const target = appState.students.find(s => s.id === reviewer.assignedToId);

          triggerConfetti();
          playCelebrationChime();
          showToast(`已成功遞交互評！你的意見已回傳給原作者同學！`, "success");
          saveStateToStorage();
          renderAll();

          // If all reviews are completed, automatically prompt or notify
          const activeReviewers = appState.students.filter(s => s.assignedToId);
          const allDone = activeReviewers.every(s => s.reviewGiven.submitted);
          if (allDone && appState.phase === 2) {
            setTimeout(() => {
              showToast("全班所有互評均已完成！自動進入第 3 階段（原作者收回意見）！", "success");
