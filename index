<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>班級作品限時上傳與同儕互評系統</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts: Inter & Noto Sans TC -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'Noto Sans TC', 'system-ui', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* iPad Safari optimization */
    html {
      -webkit-tap-highlight-color: transparent;
      -webkit-text-size-adjust: 100%;
    }
    input, textarea, select {
      font-size: 16px !important; /* Prevents iOS auto-zoom on focus */
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    .pulse-urgent {
      animation: pulseAlert 1s infinite alternate;
    }
    @keyframes pulseAlert {
      from { transform: scale(1); opacity: 1; }
      to { transform: scale(1.04); opacity: 0.9; }
    }
    .modal-backdrop {
      background-color: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(4px);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">

  <!-- ================= TOP RESUME ALERT NOTIFICATION ================= -->
  <div id="sessionResumedBanner" class="hidden bg-gradient-to-r from-emerald-600 to-teal-700 text-white px-4 py-2.5 shadow-md no-print transition-all duration-300">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 text-xs sm:text-sm font-medium">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-base flex-shrink-0">💾</span>
        <span id="sessionResumedText" class="truncate">
          已為你自動恢復上次未完成的工作進度！
        </span>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="text-[11px] bg-white/20 px-2 py-0.5 rounded-full font-mono">已記憶於此裝置</span>
        <button type="button" id="dismissResumeBannerBtn" class="text-white hover:text-emerald-200 text-sm font-bold px-1.5 py-0.5 rounded">
          ✕
        </button>
      </div>
    </div>
  </div>


  <!-- ================= TOP NAVIGATION & ROLE SWITCHER ================= -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Brand Title & Phase Indicator -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-md shadow-indigo-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">課堂作品限時互評系統</h1>
              <span id="headerPhaseBadge" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-indigo-100 text-indigo-700 border border-indigo-200">
                階段一：限時上傳中
              </span>
              <span id="storageStatusBadge" class="hidden sm:inline-flex items-center gap-1.5 text-[11px] px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200" title="所有作品與互評紀錄均已自動儲存至本機快取">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>進度已自動儲存</span>
              </span>
            </div>
            <p class="text-xs text-slate-500 hidden sm:block">上傳作品 → 隨機錯位分發 → 評價欣賞與改善 → 原作者收回意見</p>
          </div>
        </div>

        <!-- Right Controls: Audio Toggle, Quick Demo, Role Select -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Sound Toggle -->
          <button id="soundToggleBtn" title="切換音效開關" class="p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition">
            <svg id="soundOnIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
            </svg>
            <svg id="soundOffIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
            </svg>
          </button>

          <!-- System Identity Principles Explainer Button -->
          <button id="showHowItWorksHeaderBtn" class="text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 font-medium px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow-sm" title="了解系統如何得知作品屬於哪位同學">
            <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="hidden sm:inline">🔍 作品歸屬識別原理</span>
            <span class="sm:hidden">識別原理</span>
          </button>

          <!-- Quick Load Demo Data -->
          
          <!-- GitHub Guide Button -->
          <button type="button" id="openGithubGuideBtn" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-2.5 py-1.5 rounded-xl transition flex items-center gap-1">
            <svg class="w-4 h-4 text-slate-700" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span class="hidden md:inline">GitHub Pages 指南</span>
          </button>

          <button id="loadDemoBtn" class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 font-medium px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="hidden md:inline">載入示範班級資料</span>
            <span class="md:hidden">示範資料</span>
          </button>

          <!-- Active View / Role Switcher -->
          <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
            <button id="roleTeacherBtn" class="px-3 py-1.5 text-xs font-semibold rounded-lg transition bg-white text-indigo-700 shadow-sm">
              教師大螢幕
            </button>
            <button id="roleStudentBtn" class="px-3 py-1.5 text-xs font-semibold rounded-lg transition text-slate-600 hover:text-slate-900">
              學生端操作
            </button>
          </div>

        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTAINER ================= -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full flex flex-col gap-6">

    <!-- ========== GLOBAL TIMELINE / PROGRESS STEPPER ========== -->
    <section class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        
        <!-- Steps -->
        <div class="grid grid-cols-3 gap-2 w-full md:w-auto md:flex items-center md:gap-4 flex-1">
          
          <!-- Step 1 -->
          <div id="stepIndicator1" class="flex items-center gap-3 p-2 sm:p-2.5 rounded-xl border border-indigo-300 bg-indigo-50/70">
            <div id="stepCircle1" class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">1</div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-indigo-900 truncate">第 1 階段：限時上傳</p>
              <p class="text-[11px] text-indigo-700 truncate">學生限時提交作品圖片</p>
            </div>
          </div>

          <!-- Arrow -->
          <div class="hidden md:flex text-slate-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>

          <!-- Step 2 -->
          <div id="stepIndicator2" class="flex items-center gap-3 p-2 sm:p-2.5 rounded-xl border border-slate-200 bg-slate-50 opacity-60">
            <div id="stepCircle2" class="w-8 h-8 rounded-full bg-slate-300 text-slate-700 flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">2</div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-slate-800 truncate">第 2 階段：隨機互評</p>
              <p class="text-[11px] text-slate-500 truncate">獲派他人作品並填寫意見</p>
            </div>
          </div>

          <!-- Arrow -->
          <div class="hidden md:flex text-slate-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>

          <!-- Step 3 -->
          <div id="stepIndicator3" class="flex items-center gap-3 p-2 sm:p-2.5 rounded-xl border border-slate-200 bg-slate-50 opacity-60">
            <div id="stepCircle3" class="w-8 h-8 rounded-full bg-slate-300 text-slate-700 flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">3</div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-slate-800 truncate">第 3 階段：原作者收回</p>
              <p class="text-[11px] text-slate-500 truncate">查閱同儕回饋與全班展覽</p>
            </div>
          </div>

        </div>

        <!-- Teacher Countdown Timer Bar (Compact View) -->
        <div class="flex items-center gap-3 bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-md w-full md:w-auto justify-between md:justify-end">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="text-xs text-slate-300 font-medium">階段計時</span>
          </div>
          <div id="timerDisplay" class="font-mono text-2xl font-black tracking-wider text-emerald-400">
            15:00
          </div>
          <div class="flex items-center gap-1.5">
            <button id="timerToggleBtn" class="text-xs px-2.5 py-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-slate-200 transition font-medium">
              暫停
            </button>
            <button id="forceNextPhaseBtn" class="text-xs px-2.5 py-1 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-white font-medium shadow-sm transition">
              時間到！立即分發
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- ============================================================== -->
    <!-- VIEW A: TEACHER / PROJECTOR DASHBOARD                         -->
    <!-- ============================================================== -->
    <div id="teacherView" class="space-y-6">
      
      <!-- Phase 1 Teacher Upload Overview Banner -->
      <div id="teacherPhase1Banner" class="bg-gradient-to-r from-indigo-700 via-indigo-600 to-violet-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold mb-3">
              <svg class="w-4 h-4 text-amber-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path></svg>
              作品限時上傳進行中（預設 15 分鐘）
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">請同學在時間截止前上傳自己的作品圖片</h2>
            <p class="text-indigo-100 text-sm mt-2 leading-relaxed">
              計時結束後，系統將自動啟動<strong class="text-white underline decoration-amber-400 decoration-2">「隨機錯位分發」</strong>，每位同學都將隨機收到一位同學的作品進行盲評，完成兩大回饋（欣賞點與改進建議）後，原作者即可收回意見！
            </p>
          </div>

          <!-- Quick Controls on Big Screen -->
          <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 w-full lg:w-64">
            <div class="bg-black/30 backdrop-blur-md p-3.5 rounded-2xl border border-white/10 text-center">
              <p class="text-xs text-indigo-200">目前上傳進度</p>
              <div class="flex items-baseline justify-center gap-1 my-1">
                <span id="submittedCountBig" class="text-3xl font-extrabold text-white">0</span>
                <span class="text-lg text-indigo-300">/</span>
                <span id="totalStudentsCountBig" class="text-lg font-bold text-indigo-300">0</span>
              </div>
              <div class="w-full bg-white/20 rounded-full h-2 mt-2 overflow-hidden">
                <div id="uploadProgressBar" class="bg-emerald-400 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
              </div>
            </div>

            <!-- Set Custom Time Buttons -->
            <div class="flex items-center gap-1.5 justify-center bg-white/10 p-1.5 rounded-xl text-xs">
              <span class="text-indigo-200 text-[11px] px-1">設時長:</span>
              <button class="set-timer-btn px-2 py-1 bg-white/20 hover:bg-white/30 rounded font-medium" data-mins="1">1分(測)</button>
              <button class="set-timer-btn px-2 py-1 bg-white/20 hover:bg-white/30 rounded font-medium" data-mins="5">5分鐘</button>
              <button class="set-timer-btn px-2 py-1 bg-white/20 hover:bg-white/30 rounded font-medium" data-mins="15">15分鐘</button>
              <button class="set-timer-btn px-2 py-1 bg-white/20 hover:bg-white/30 rounded font-medium" data-mins="30">30分鐘</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 2 Teacher Matching Banner (Hidden in Phase 1) -->
      <div id="teacherPhase2Banner" class="hidden bg-gradient-to-r from-amber-600 via-orange-600 to-amber-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold mb-2">
              <svg class="w-4 h-4 text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
              作品已隨機分發完成！
            </div>
            <h2 class="text-2xl font-black">第 2 階段：全班同儕互評撰寫中</h2>
            <p class="text-amber-100 text-sm mt-1">
              每位同學已分得一張「別人的作品」。請同學針對 <strong>1) 欣賞的地方</strong> 及 <strong>2) 不足及改善方案</strong> 提出中肯具體建議。
            </p>
          </div>
          <div class="flex items-center gap-3">
            <button id="btnFastForwardPhase3" class="px-4 py-2.5 bg-white text-orange-900 hover:bg-amber-50 font-bold rounded-xl shadow-lg transition text-xs sm:text-sm flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              前往第 3 階段：發布回饋給原作者
            </button>
          </div>
        </div>
      </div>

      <!-- Phase 3 Teacher Results Banner (Hidden initially) -->
      <div id="teacherPhase3Banner" class="hidden bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold mb-2">
              <svg class="w-4 h-4 text-emerald-200" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              互評圓滿完成！
            </div>
            <h2 class="text-2xl font-black">第 3 階段：所有作品原作者已收回同學意見！</h2>
            <p class="text-emerald-100 text-sm mt-1">
              學生端現已可查閱同學留下的詳細建議；教師可在下方檢閱全班互評總覽矩陣或匯出報告。
            </p>
          </div>
          <div class="flex items-center gap-3">
            <button id="exportReportBtn" class="px-4 py-2.5 bg-white text-emerald-900 hover:bg-emerald-50 font-bold rounded-xl shadow-lg transition text-xs sm:text-sm flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              匯出全班互評成果報告
            </button>
            <button id="restartSessionBtn" class="px-3.5 py-2.5 bg-emerald-800/80 hover:bg-emerald-800 text-emerald-100 font-medium rounded-xl text-xs transition border border-emerald-500/50">
              重新開始新單元
            </button>
          </div>
        </div>
      </div>

      <!-- Live Student Grid & Submissions Status -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-100 gap-4">
          <div>
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <span>全班學生名冊與作品狀態</span>
              <span id="classStatusCountBadge" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-slate-100 text-slate-600">
                共 0 位學生
              </span>
            </h3>
            <p class="text-xs text-slate-500 mt-1">可隨時點擊學生卡片切換至該同學視角，體驗從上傳到獲派互評的完整歷程</p>
          </div>

