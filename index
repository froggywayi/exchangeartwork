        // Submit Review Button
        document.getElementById('submitReviewBtn').addEventListener('click', () => {
          const reviewer = appState.students.find(s => s.id === appState.currentStudentId);
          if (!reviewer || !reviewer.assignedToId) {
            showToast("目前未獲派互評作品或未在互評階段！", "error");
            return;
