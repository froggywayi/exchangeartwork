      ];

      // Application State
      let appState = {
        phase: 1, // 1: Upload, 2: Peer Review, 3: Author Received
        timer: {
          remainingSeconds: 15 * 60, // Default 15 minutes = 900s
          isRunning: true,
          totalDuration: 15 * 60
        },
        activeRole: "teacher", // "teacher" | "student"
