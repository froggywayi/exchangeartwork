      };

      let timerInterval = null;

      // -------------------------------------------------------------
      // LOCALSTORAGE & CROSS-TAB BROADCAST PERSISTENCE
      // -------------------------------------------------------------
      const STORAGE_KEY = 'CLASSROOM_PEER_REVIEW_DATA_V2';
      let syncBroadcast = null;
      try {
        if (typeof BroadcastChannel !== 'undefined') {
          syncBroadcast = new BroadcastChannel('classroom_peer_review_channel');
          syncBroadcast.onmessage = (event) => {
            if (event.data && event.data.type === 'STATE_UPDATED') {
              loadStateFromStorage(false);
              renderAll();
            }
          };
        }
      } catch (e) {
        // BroadcastChannel unavailable
      }

      function saveStateToStorage(broadcast = true) {
        try {
          const payload = {
            phase: appState.phase,
            timer: {
              remainingSeconds: appState.timer.remainingSeconds,
              totalDuration: appState.timer.totalDuration,
              isRunning: appState.timer.isRunning
            },
            currentStudentId: appState.currentStudentId,
            soundEnabled: appState.soundEnabled,
            students: appState.students,
            savedAt: Date.now()
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
          if (broadcast && syncBroadcast) {
            syncBroadcast.postMessage({ type: 'STATE_UPDATED', timestamp: Date.now() });
          }
        } catch (e) {
          console.warn("Storage save failed:", e);
        }
      }

      function loadStateFromStorage(showToastNotice = true) {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return false;
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.students) && parsed.students.length > 0) {
            appState.phase = parsed.phase || 1;
            appState.timer.remainingSeconds = typeof parsed.timer?.remainingSeconds === 'number' ? parsed.timer.remainingSeconds : 15 * 60;
            appState.timer.totalDuration = typeof parsed.timer?.totalDuration === 'number' ? parsed.timer.totalDuration : 15 * 60;
            appState.timer.isRunning = parsed.timer ? parsed.timer.isRunning : true;
            appState.currentStudentId = parsed.currentStudentId || appState.students[0].id;
            appState.soundEnabled = parsed.soundEnabled !== undefined ? parsed.soundEnabled : true;
            appState.students = parsed.students;

            if (showToastNotice) {
              setTimeout(() => {
                showToast("已成功載入先前已儲存的學生作品與評語紀錄！", "success");
              }, 400);
            }
            return true;
          }
        } catch (e) {
          console.warn("Storage load failed:", e);
        }
        return false;
      }

      function clearStorageData() {
        try {
          localStorage.removeItem(STORAGE_KEY);
          if (syncBroadcast) {
            syncBroadcast.postMessage({ type: 'STATE_UPDATED', timestamp: Date.now() });
          }
        } catch (e) {}
      }

      // Web Audio API Synthesizer (Zero external dependencies)
      let audioCtx = null;
      function playTone(freq = 440, type = 'sine', duration = 0.15) {
        if (!appState.soundEnabled) return;
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
          gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + duration);
        } catch (e) {
          // Audio blocked or not permitted
        }
      }

      function playCelebrationChime() {
        playTone(523.25, 'triangle', 0.2); // C5
        setTimeout(() => playTone(659.25, 'triangle', 0.2), 120); // E5
        setTimeout(() => playTone(783.99, 'triangle', 0.3), 240); // G5
        setTimeout(() => playTone(1046.50, 'triangle', 0.4), 360); // C6
      }

      function triggerConfetti() {
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 80,
            spread: 70,
            origin: { y: 0.6 }
          });
        }
      }

      // Toast Notification Helper
      function showToast(message, type = 'info') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-2 transform transition-all duration-300 pointer-events-auto border ${
          type === 'success' ? 'bg-emerald-600 text-white border-emerald-500' :
          type === 'warning' ? 'bg-amber-500 text-white border-amber-400' :
          type === 'error' ? 'bg-rose-600 text-white border-rose-500' :
          'bg-slate-900 text-white border-slate-700'
        }`;
        
        let icon = 'ℹ️';
        if (type === 'success') icon = '✓';
        if (type === 'warning') icon = '⚠️';
        if (type === 'error') icon = '✕';

        toast.innerHTML = `<span>${icon}</span><span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(8px)';
          setTimeout(() => toast.remove(), 300);
        }, 3200);
