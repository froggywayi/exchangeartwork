      function switchStudentTab(tab) {
        const secUpload = document.getElementById('studentSectionUpload');
        const secReview = document.getElementById('studentSectionReview');
        const secFeedback = document.getElementById('studentSectionFeedback');

        const tabUploadBtn = document.getElementById('studentTabUploadBtn');
        const tabReviewBtn = document.getElementById('studentTabReviewBtn');
