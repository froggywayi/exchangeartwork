      // -------------------------------------------------------------
      /**
       * Strictly guarantees a derangement: for all i, assigned[i] != i
       * No student can ever receive their own uploaded artwork!
       */
      function performDerangementMatching() {
        // Only match students who have uploaded an artwork
        const activeStudents = appState.students.filter(s => s.hasUploaded && s.artwork);
        
        if (activeStudents.length < 2) {
          showToast("上傳人數少於 2 人，無法進行同儕隨機互評配對！請先上傳至少 2 件作品。", "warning");
          return false;
        }

        const n = activeStudents.length;
        const studentIds = activeStudents.map(s => s.id);

        // Shuffle using Fisher-Yates until no fixed points (derangement)
        // or systematically generate a cyclic permutation to guarantee derangement
        const shuffled = [...studentIds];
        
        // Circular shift guarantee derangement: shuffled[i] = studentIds[(i + shift) % n]
        // Pick a random shift from 1 to n - 1
        const shift = Math.floor(Math.random() * (n - 1)) + 1;
        
        // Randomize the order first to ensure randomness
        for (let i = studentIds.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [studentIds[i], studentIds[j]] = [studentIds[j], studentIds[i]];
        }

        // Map reviewer -> target (deranged cyclic offset)
        const matchMap = {};
        for (let i = 0; i < n; i++) {
          const reviewerId = studentIds[i];
          const targetId = studentIds[(i + shift) % n];
          matchMap[reviewerId] = targetId;
        }

        // Apply matches to state
        appState.students.forEach(s => {
          if (matchMap[s.id]) {
            s.assignedToId = matchMap[s.id];
          } else {
            s.assignedToId = null;
          }
        });

        return true;
      }

      // -------------------------------------------------------------
      // 3. TIMER LOGIC
      // -------------------------------------------------------------
      function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
      }

      function updateTimerUI() {
        const display = document.getElementById('timerDisplay');
        display.textContent = formatTime(appState.timer.remainingSeconds);
        
        if (appState.timer.remainingSeconds <= 30 && appState.phase === 1) {
          display.classList.add('text-rose-400', 'pulse-urgent');
          display.classList.remove('text-emerald-400');
        } else {
          display.classList.remove('text-rose-400', 'pulse-urgent');
          display.classList.add('text-emerald-400');
        }

        const toggleBtn = document.getElementById('timerToggleBtn');
        toggleBtn.textContent = appState.timer.isRunning ? '暫停' : '繼續';
      }

      function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        appState.timer.isRunning = true;
        updateTimerUI();

        timerInterval = setInterval(() => {
          if (!appState.timer.isRunning) return;

          if (appState.timer.remainingSeconds > 0) {
            appState.timer.remainingSeconds--;
            updateTimerUI();

            // Sound beep on last 5 seconds
            if (appState.timer.remainingSeconds <= 5 && appState.timer.remainingSeconds > 0 && appState.phase === 1) {
              playTone(880, 'sine', 0.08);
            }
          } else {
            // Time is UP!
            clearInterval(timerInterval);
            timerInterval = null;
            appState.timer.isRunning = false;
            updateTimerUI();

            if (appState.phase === 1) {
              playCelebrationChime();
              showToast("⏰ 15 分鐘上傳時間已截止！系統正在隨機分發作品...", "warning");
              transitionToPhase(2);
            }
          }
        }, 1000);
      }

      function pauseTimer() {
        appState.timer.isRunning = false;
        updateTimerUI();
      }

      function setCustomTimer(mins) {
        appState.timer.totalDuration = mins * 60;
        appState.timer.remainingSeconds = mins * 60;
        appState.timer.isRunning = true;
        startTimer();
        showToast(`已重設計時器為 ${mins} 分鐘！`, "info");
      }

      // -------------------------------------------------------------
      // 4. PHASE TRANSITIONS
      // -------------------------------------------------------------
      function transitionToPhase(newPhase) {
        appState.phase = newPhase;

        // Phase badge
        const badge = document.getElementById('headerPhaseBadge');
        if (newPhase === 1) {
          badge.textContent = "階段一：限時上傳中";
          badge.className = "text-xs px-2.5 py-0.5 rounded-full font-semibold bg-indigo-100 text-indigo-700 border border-indigo-200";
        } else if (newPhase === 2) {
          badge.textContent = "階段二：作品互評中";
          badge.className = "text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200";
        } else if (newPhase === 3) {
          badge.textContent = "階段三：原作者收回意見";
          badge.className = "text-xs px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200";
        }

        // Stepper Styling
        [1, 2, 3].forEach(step => {
          const indicator = document.getElementById(`stepIndicator${step}`);
          const circle = document.getElementById(`stepCircle${step}`);
          if (step === newPhase) {
            indicator.className = "flex items-center gap-3 p-2 sm:p-2.5 rounded-xl border border-indigo-400 bg-indigo-50/90 shadow-sm";
            circle.className = "w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0";
          } else if (step < newPhase) {
            indicator.className = "flex items-center gap-3 p-2 sm:p-2.5 rounded-xl border border-emerald-300 bg-emerald-50/60";
            circle.className = "w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0";
          } else {
            indicator.className = "flex items-center gap-3 p-2 sm:p-2.5 rounded-xl border border-slate-200 bg-slate-50 opacity-60";
            circle.className = "w-8 h-8 rounded-full bg-slate-300 text-slate-700 flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0";
          }
        });

        // Teacher Banners
        const banner1 = document.getElementById('teacherPhase1Banner');
        const banner2 = document.getElementById('teacherPhase2Banner');
        const banner3 = document.getElementById('teacherPhase3Banner');
        const matrixSec = document.getElementById('teacherReviewMatrixSection');

        if (newPhase === 1) {
          banner1.classList.remove('hidden');
          banner2.classList.add('hidden');
          banner3.classList.add('hidden');
          matrixSec.classList.add('hidden');
        } else if (newPhase === 2) {
          banner1.classList.add('hidden');
          banner2.classList.remove('hidden');
          banner3.classList.add('hidden');
          matrixSec.classList.remove('hidden');

          // Trigger Random Matching!
          const matchSuccess = performDerangementMatching();
          if (matchSuccess) {
            triggerConfetti();
            playCelebrationChime();
            showToast("✨ 作品已成功隨機錯位分發！同學不可評審自己作品。", "success");
          }
        } else if (newPhase === 3) {
          banner1.classList.add('hidden');
          banner2.classList.add('hidden');
          banner3.classList.remove('hidden');
          matrixSec.classList.remove('hidden');
          triggerConfetti();
          playCelebrationChime();
          showToast("🎉 已全數發布！所有原作者皆可收回同學給予的意見！", "success");
        }

        saveStateToStorage();
        renderAll();
      }

